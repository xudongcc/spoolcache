# Optional overrides for scripts/gemma-pp2-dev.sh.
#
# The checked-in defaults describe the two DGX Spark CX-7 lab used by the G4
# qualification. Copy this file to .env.gemma-pp2 only when the host wiring or
# storage locations differ. Model, revision, vLLM image and PP layout are fixed
# by the launcher so the development baseline remains reproducible.

GEMMA_HEAD_IP=10.100.216.1
GEMMA_WORKER_IP=10.100.216.2
GEMMA_WORKER_SSH=10.100.216.2

GEMMA_HEAD_HF_HOME=/root/.cache/huggingface
GEMMA_WORKER_HF_HOME=/root/.cache/huggingface
GEMMA_HEAD_CACHE_ROOT=/var/tmp/spoolcache-gemma-pp2
GEMMA_WORKER_CACHE_ROOT=/var/tmp/spoolcache-gemma-pp2

GEMMA_HEAD_GLOO_IFACE=enp1s0f1np1
GEMMA_WORKER_GLOO_IFACE=enp1s0f1np1
GEMMA_HEAD_NCCL_IFACES='=enp1s0f1np1,enP2p1s0f1np1'
GEMMA_WORKER_NCCL_IFACES='=enp1s0f1np1,enP2p1s0f1np1'
GEMMA_HEAD_NCCL_HCAS='=rocep1s0f1,roceP2p1s0f1'
GEMMA_WORKER_NCCL_HCAS='=rocep1s0f1,roceP2p1s0f1'
GEMMA_NCCL_GID_INDEX=3
